(defmodule bedit-theme-solarized-light
  "The Solarized Light theme for bedit, as a plugin contribution — pure data. Exposes
`(bedit-plugin)`, the contribution map the host folds into M-x theme-select.")
(def *palette*
  {:base "#fdf6e3"
   :mantle "#eee8d5"
   :surface0 "#eee8d5"
   :surface1 "#d9d2b8"
   :surface2 "#c9c2a8"
   :overlay0 "#93a1a1"
   :overlay1 "#839496"
   :text "#586e75"
   :subtext "#657b83"
   :blue "#268bd2"
   :mauve "#6c71c4"
   :green "#859900"
   :yellow "#b58900"
   :peach "#cb4b16"
   :red "#dc322f"
   :teal "#2aa198"})

(defn bedit-plugin ()
  "This package's contribution to bedit: a `:themes` vector the host registers."
  {:themes [{:name "Solarized Light" :palette *palette*}]})
