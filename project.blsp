;; bedit-theme-solarized-light — a Solarized Light colour theme for the bedit editor, a hive PLUGIN
;; package (`:enhances bedit`). Pure data; installed at runtime via M-x package-list.
(project
  :name "bedit-theme-solarized-light"
  :version "0.3.3"
  :brood ">= 0.39.0"
  :description
    "The Solarized Light colour theme for the bedit editor — a plugin package (:enhances bedit)."
  :repository "https://github.com/broodlang/bedit-theme-solarized-light"
  :enhances {bedit ">= 0.4"}
  :source-paths ["src"])
